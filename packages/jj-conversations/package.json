{
  "name": "@lapismd/jj-conversations",
  "version": "0.1.0",
  "description": "Headless exact-request conversation clients, agent mentions and delivery projections",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevejuma/jj-store.git",
    "directory": "packages/jj-conversations"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && tsc -p tsconfig.test.json --noEmit && node --test tests/*.test.mjs",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
