{
  "name": "@lapismd/jj-store",
  "version": "0.1.0",
  "private": true,
  "description": "Native JJ repository authority backed by RustFS",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build-storybook && pnpm web:build && pnpm build:embedded-rustfs && node scripts/managed-cargo.mjs build --workspace --locked",
    "check": "pnpm docs:check && pnpm spec:validate && pnpm check:boundaries && pnpm check:architecture && pnpm check:progress && pnpm format:rust:check && pnpm check:embedded-rustfs && pnpm contracts:check && pnpm web:check && pnpm catalog:check && node scripts/managed-cargo.mjs clippy --workspace --all-targets --locked -- -D warnings",
    "check:architecture": "node scripts/web-architecture.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:progress": "node scripts/check-progress.mjs",
    "test:governance": "node --test scripts/web-manifest.test.mjs scripts/dev-demo-repository.test.mjs scripts/governance.test.mjs scripts/progress-mapping.test.mjs scripts/local-package-pnpmfile.test.mjs scripts/web-architecture.test.mjs scripts/ui-ownership.test.mjs scripts/build-storage.test.mjs scripts/managed-cargo.test.mjs",
    "test": "pnpm test:governance && pnpm test:storage-harness && pnpm test:embedded-rustfs && pnpm test:managed-rustfs && pnpm test:local-trusted && pnpm test:contracts && pnpm web:test && pnpm catalog:test && pnpm test:storybook && pnpm catalog:test:browser && node scripts/managed-cargo.mjs test --workspace --locked",
    "spec:build": "spec-validator build",
    "spec:links": "python3 scripts/spec/book-audit.py",
    "spec:check": "spec-validator check",
    "spec:first": "spec-validator first",
    "spec:validate": "spec-validator validate",
    "format:check": "pnpm format:rust:check && prettier --check .",
    "format": "pnpm format:rust && prettier --write .",
    "test:storage-harness": "python3 scripts/rustfs-contract.py --self-test",
    "test:rustfs": "python3 scripts/rustfs-contract.py --run",
    "build:embedded-rustfs": "node scripts/managed-cargo.mjs build --manifest-path runtime/embedded-rustfs/Cargo.toml --locked",
    "check:embedded-rustfs": "node scripts/managed-cargo.mjs clippy --manifest-path runtime/embedded-rustfs/Cargo.toml --all-targets --locked -- -D warnings",
    "test:embedded-rustfs": "pnpm build:embedded-rustfs && JJ_STORE_RUSTFS_RUNTIME=$PWD/runtime/embedded-rustfs/target/debug/jj-store-rustfs node scripts/managed-cargo.mjs test -p jj-store-server --test embedded_storage --locked -- --ignored --exact embedded_rustfs_preserves_objects_across_graceful_restart",
    "test:managed-rustfs": "pnpm build:embedded-rustfs && JJ_STORE_RUSTFS_RUNTIME=$PWD/runtime/embedded-rustfs/target/debug/jj-store-rustfs node scripts/managed-cargo.mjs test -p jj-store-server --test embedded_storage --locked -- --ignored --exact managed_local_storage_locks_verifies_and_fails_closed",
    "test:local-trusted": "pnpm build:embedded-rustfs && JJ_STORE_RUSTFS_RUNTIME=$PWD/runtime/embedded-rustfs/target/debug/jj-store-rustfs node scripts/managed-cargo.mjs test -p jj-store --test server_executable --locked -- --ignored --exact local_trusted_executable_bootstraps_registers_and_serves_without_tokens",
    "format:rust": "cargo fmt --all && cargo fmt --manifest-path runtime/embedded-rustfs/Cargo.toml",
    "format:rust:check": "cargo fmt --all -- --check && cargo fmt --manifest-path runtime/embedded-rustfs/Cargo.toml -- --check",
    "contracts:generate": "node scripts/contracts.mjs --write",
    "contracts:check": "node scripts/contracts.mjs --check && pnpm test:contracts",
    "test:contracts": "node --test scripts/contracts.test.mjs && tsc -p scripts/tsconfig.contracts.json",
    "web:check": "svelte-check --tsconfig web/tsconfig.json",
    "web:build": "vite build --config web/vite.config.ts && node scripts/web-manifest.mjs && node scripts/docs.mjs stage",
    "web:dev": "pnpm docs:build && vite --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "dev:capture:setup": "node scripts/dev-capture.mjs setup",
    "dev:capture": "node scripts/dev-capture.mjs start",
    "dev:capture:restart": "node scripts/dev-capture.mjs restart",
    "dev:capture:stop": "node scripts/dev-capture.mjs stop",
    "dev:restart": "node scripts/dev-demo.mjs restart",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:backend:restart": "node scripts/dev-ui.mjs backend",
    "dev:backend:build": "node scripts/managed-cargo.mjs build -p jj-store --bins --locked",
    "test:dev:ui": "node scripts/dev-ui.acceptance.mjs",
    "dev:reset": "node scripts/dev-demo.mjs reset",
    "dev:stop": "node scripts/dev-demo.mjs stop",
    "cli:install": "node scripts/install-cli.mjs",
    "dev:seed:work": "node scripts/dev-demo.mjs seed-work",
    "web:test": "tsx --test web/tests/*.test.ts",
    "web:test:browser": "pnpm web:build && node scripts/browser-fixtures.mjs && playwright test --config web/playwright.config.ts",
    "web:test:real": "node scripts/real-browser-acceptance.mjs",
    "test:local-release": "JJ_STORE_LOCAL_RELEASE_QUALIFY=1 pnpm web:test:real",
    "storybook": "storybook dev --host 127.0.0.1 --port 6046 --no-open --disable-telemetry",
    "test:storybook": "vitest run --config catalog/vitest.config.ts --project storybook",
    "build-storybook": "storybook build --disable-telemetry",
    "catalog:check": "svelte-check --tsconfig catalog/tsconfig.json --fail-on-warnings && node scripts/check-catalog.mjs",
    "catalog:test": "vitest run --config catalog/vitest.config.ts --project catalog-unit",
    "catalog:test:browser": "pnpm build-storybook && node --test scripts/catalog-browser.test.mjs",
    "check:ui-ownership": "spec-validator validate --only ui-ownership",
    "desktop:prepare": "node scripts/desktop.mjs prepare",
    "desktop:run": "node scripts/desktop.mjs run",
    "desktop:check": "node scripts/desktop.mjs check",
    "desktop:test": "node scripts/desktop.mjs test",
    "desktop:bundle": "node scripts/desktop.mjs bundle",
    "docs:generate": "node scripts/docs.mjs generate",
    "docs:check": "node scripts/docs.mjs check",
    "docs:review": "node scripts/docs.mjs review",
    "docs:build": "node scripts/docs.mjs build",
    "docs:serve": "node scripts/docs.mjs serve",
    "docs:test": "node --test scripts/docs.test.mjs && node scripts/managed-cargo.mjs test --locked -p jj-store-server --test configuration documentation_configuration_examples_use_production_validation -- --exact",
    "docs:test:browser": "pnpm web:build && playwright test --config web/playwright.docs.config.ts",
    "test:spec": "node --test scripts/spec/*.test.mjs",
    "spec:search": "spec-validator search",
    "spec:index": "spec-validator index",
    "evidence:new": "node scripts/spec/evidence-new.mjs",
    "progress:history": "node scripts/spec/progress-history.mjs",
    "dev:disk": "node scripts/build-storage.mjs report",
    "dev:clean": "node scripts/build-storage.mjs clean",
    "dev:cargo": "node scripts/managed-cargo.mjs",
    "dev:target:register": "node scripts/build-storage.mjs register",
    "dev:target:complete": "node scripts/build-storage.mjs complete",
    "dev:target:retire": "node scripts/build-storage.mjs retire",
    "test:build-storage": "node --test scripts/build-storage.test.mjs scripts/managed-cargo.test.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/release-version.mjs && pnpm install --lockfile-only --ignore-pnpmfile && prettier --write package.json CHANGELOG.md",
    "release:check": "node --test scripts/release.test.mjs scripts/ci*.test.mjs scripts/automation-governance.test.mjs && node scripts/package-check.mjs",
    "release:orchestrate": "node scripts/release-orchestrate.mjs",
    "release:registry": "node scripts/release-registry.mjs",
    "test:release": "node --test scripts/release.test.mjs scripts/ci*.test.mjs scripts/automation-governance.test.mjs",
    "ci:plan": "node scripts/ci-plan.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/inter": "5.2.8",
    "@lapismd/design-core": "^0.5.0",
    "@lapismd/mira": "~0.0.3",
    "@lapismd/spec-validator": "^0.1.4",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.21.0",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.63.0",
    "@shikijs/themes": "4.0.2",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/builder-vite": "10.5.7",
    "@storybook/svelte": "10.5.7",
    "@storybook/svelte-vite": "10.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-query": "^6.3.0",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tauri-apps/api": "~2.11.1",
    "@tobilu/qmd": "2.5.3",
    "@types/node": "^24.19.0",
    "@vitest/browser-playwright": "^4.1.11",
    "ajv": "^8.20.0",
    "ansi_up": "6.0.6",
    "bits-ui": "2.19.4",
    "debug": "^4.4.3",
    "emoji-mart": "^5.6.0",
    "extend": "^3.0.2",
    "lossless-json": "^4.3.1",
    "mermaid": "11.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.5.7",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "ws": "8.22.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-llama-cpp"
    ]
  }
}
